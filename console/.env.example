# Copy to .env and change every value.

# Front end - pick ONE block.
# (a) Caddy on this host's ports 80/443:
COMPOSE_PROFILES=caddy
PROXY_MODE=caddy
# Public hostname of the console (DNS A record -> VPS). "localhost" = local dev with Caddy's internal CA.
CONSOLE_DOMAIN=localhost
ACME_EMAIL=
# (b) Cloudflare Tunnel, no ports published (80/443 already used by another app):
# COMPOSE_PROFILES=tunnel
# PROXY_MODE=cloudflare
# CF_TUNNEL_TOKEN=paste-token-from-zero-trust-dashboard

POSTGRES_PASSWORD=change-me-long-random
SECRET_KEY=change-me-64-hex-chars

# First admin login for the dashboard (only used when no console users exist yet).
CONSOLE_ADMIN_USER=admin
CONSOLE_ADMIN_PASSWORD=change-me-please

# Optional, dev/first boot only: create tenants with a known key ("slug:key,slug2:key2").
# In production create tenants in the dashboard (Tenants) or with the CLI; keys are shown once.
BOOTSTRAP_TENANTS=demo:demo-key-change-me

# Threat-intel feeds, synced at 00/06/12/18 UTC+8 into every tenant's blocklist (per-tenant on/off in the dashboard).
# OpenPhish's free feed is non-commercial: drop "openphish" before charging for SOCLens.
FEEDS_ENABLED=true
FEED_SOURCES=phishtank,openphish,urlhaus

# Zero-config community mode: unconfigured extensions enroll themselves (own revocable token, tenant "community").
COMMUNITY_ENROLL=false
ENROLL_MAX_TOTAL=50
ENROLL_MAX_PER_IP_HOUR=5

# Public console URL (links in notifications).
CONSOLE_URL=https://soclens.example.com
# MSSP-wide Telegram channel for serious events from every tenant (per-tenant channels are set in the dashboard).
# Create a bot with @BotFather, add it to your group, read the chat id from getUpdates.
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
NOTIFY_MSSP_MIN_SEVERITY=critical
NOTIFY_MAX_PER_HOUR=20

# Wait this long for in-flight browser auth events before deciding NOT_SEEN_IN_BROWSER.
SETTLE_SEC=60
HEARTBEAT_RETENTION_DAYS=7
AUTH_EVENT_RETENTION_DAYS=30
