{
  "manifest_version": 3,
  "name": "IOC Triage – IP, Domain & Hash Lookup for SOC Analysts",
  "short_name": "IOC Triage",
  "version": "0.8.3",
  "description": "Right-click any IP, domain, URL, hash or CVE to check it in VirusTotal, AbuseIPDB, GreyNoise, Shodan and more. Free, open source.",
  "author": "OpsVantage",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "contextMenus",
    "sidePanel",
    "clipboardWrite",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "activeTab"
  ],
  "optional_permissions": [
    "webNavigation"
  ],
  "host_permissions": [
    "https://api.abuseipdb.com/*",
    "https://api.greynoise.io/*",
    "https://internetdb.shodan.io/*",
    "https://ipinfo.io/*",
    "https://www.virustotal.com/*",
    "https://threatfox-api.abuse.ch/*",
    "https://urlhaus-api.abuse.ch/*",
    "https://mb-api.abuse.ch/*",
    "https://urlscan.io/*",
    "https://rdap.org/*",
    "https://dns.google/*",
    "https://cloudflare-dns.com/*",
    "https://www.cisa.gov/*",
    "https://api.first.org/*",
    "https://services.nvd.nist.gov/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "IOC Triage",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "side_panel": {
    "default_path": "pages/analyst.html"
  }
}
