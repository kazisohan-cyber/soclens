{
  "manifest_version": 3,
  "name": "IOC Triage – IOC Lookup, Threat Intel & SOC Analyst Assistant",
  "short_name": "IOC Triage",
  "version": "0.8.0",
  "description": "Instant verdicts for any IP, domain, URL, hash or CVE, ticket notes, email header analysis, and phishing protection.",
  "author": "OpsVantage",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "webNavigation",
    "alarms",
    "notifications",
    "contextMenus",
    "sidePanel",
    "clipboardWrite",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "IOC Triage",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/ui.js",
        "content/page-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*",
        "https://outlook.cloud.microsoft/*"
      ],
      "js": [
        "content/ui.js",
        "content/webmail.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lib/ioc.js",
        "content/ioc-highlight.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "pages/analyst.html"
  }
}
